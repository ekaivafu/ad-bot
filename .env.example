# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Neon PostgreSQL Database URL (Must use postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-host.region.aws.neon.tech/neondb?ssl=require

# Admin Telegram IDs (comma-separated, e.g. 7363908717,12345678)
ADMIN_IDS=7363908717

# Initial free credits given on registration
INITIAL_CREDITS=3

# Default price/amount for manual recharge
DEFAULT_RECHARGE_AMOUNT=10

# Developer Telegram Username
DEVELOPER_USERNAME=tgekaiva

# Logging Level
LOG_LEVEL=INFO

# Python output encoding
PYTHONIOENCODING=utf-8

# Server Port
PORT=10000
